{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate --config prisma.config.ts",
    "migrate": "prisma migrate dev --config prisma.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "validate": "prisma validate --config prisma.config.ts",
    "studio": "prisma studio --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "dotenv": "^16.6.1",
    "prisma": "^7.2.0",
    "typescript": "^6.0.0"
  }
}
