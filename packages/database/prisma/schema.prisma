generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String               @id
  name              String
  email             String               @unique
  emailVerified     Boolean              @default(false)
  image             String?
  role              String               @default("AUTHOR")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          Session[]
  accounts          Account[]
  author            Author?
  assignedTickets   Ticket[]             @relation("TicketAssignee")
  ticketMessages    TicketMessage[]
  internalNotes     TicketInternalNote[]
  ticketAudits      TicketAuditEvent[]
  ticketAttachments TicketAttachment[]   @relation("TicketAttachmentUploader")

  @@map("user")
}

model Author {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  email      String   @unique
  phone      String
  city       String
  joinedDate DateTime @db.Date
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  books      Book[]
  tickets    Ticket[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Book {
  id                    String             @id @default(cuid())
  externalId            String             @unique
  authorId              String
  author                Author             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title                 String
  isbn                  String
  genre                 String
  publicationDate       DateTime?          @db.Date
  publicationStatus     String
  mrp                   Decimal?           @db.Decimal(12, 2)
  royaltyPerCopy        Decimal?           @db.Decimal(12, 2)
  totalCopiesSold       Int
  totalRoyaltyEarned    Decimal            @db.Decimal(14, 2)
  royaltyPaid           Decimal            @db.Decimal(14, 2)
  royaltyPending        Decimal            @db.Decimal(14, 2)
  lastRoyaltyPayoutDate DateTime?          @db.Date
  printPartner          String?
  distributions         BookDistribution[]
  tickets               Ticket[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([authorId])
  @@index([publicationStatus])
}

enum TicketCategory {
  ROYALTY_AND_PAYMENTS
  ISBN_AND_METADATA
  PRINTING_AND_QUALITY
  DISTRIBUTION_AND_AVAILABILITY
  BOOK_STATUS_AND_PRODUCTION
  GENERAL_INQUIRY
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketAuditAction {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CATEGORY_CHANGED
  ASSIGNMENT_CHANGED
  ADMIN_MESSAGE_CREATED
  AUTHOR_MESSAGE_CREATED
  INTERNAL_NOTE_CREATED
}

enum AiProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Ticket {
  id                         String               @id @default(cuid())
  reference                  String               @unique
  authorId                   String
  author                     Author               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  bookId                     String?
  book                       Book?                @relation(fields: [bookId], references: [id], onDelete: SetNull)
  subject                    String
  description                String
  category                   TicketCategory       @default(GENERAL_INQUIRY)
  priority                   TicketPriority       @default(MEDIUM)
  status                     TicketStatus         @default(OPEN)
  assignedAdminId            String?
  assignedAdmin              User?                @relation("TicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  resolvedAt                 DateTime?
  closedAt                   DateTime?
  version                    Int                  @default(0)
  aiSuggestedCategory        TicketCategory?
  aiSuggestedPriority        TicketPriority?
  aiClassificationConfidence Float?
  aiPriorityConfidence       Float?
  aiClassificationReasoning  String?
  aiPriorityReasoning        String?
  aiKnowledgeSections        Json?
  aiStatus                   AiProcessingStatus   @default(PENDING)
  aiProvider                 String?
  aiModel                    String?
  aiPromptVersion            String?
  aiProcessedAt              DateTime?
  aiError                    String?
  aiAttempts                 Int                  @default(0)
  categoryOverriddenAt       DateTime?
  priorityOverriddenAt       DateTime?
  messages                   TicketMessage[]
  internalNotes              TicketInternalNote[]
  auditEvents                TicketAuditEvent[]
  attachments                TicketAttachment[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([authorId, createdAt])
  @@index([bookId])
  @@index([status, priority, createdAt])
  @@index([assignedAdminId, status, createdAt])
  @@index([aiStatus, createdAt])
}

model TicketMessage {
  id           String    @id @default(cuid())
  ticketId     String
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User      @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  content      String
  createdAt    DateTime  @default(now())
  editedAt     DateTime?

  @@index([ticketId, createdAt])
  @@index([senderUserId])
}

model TicketInternalNote {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminUserId String
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  content     String
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([adminUserId])
}

model TicketAuditEvent {
  id          String            @id @default(cuid())
  ticketId    String
  ticket      Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      TicketAuditAction
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([ticketId, createdAt])
  @@index([actorUserId])
}

model Platform {
  id            String             @id @default(cuid())
  name          String             @unique
  distributions BookDistribution[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model BookDistribution {
  bookId     String
  platformId String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([bookId, platformId])
  @@index([platformId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TicketAttachment {
  id                 String   @id @default(cuid())
  ticketId           String
  ticket             Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedByUserId   String
  uploadedByUser     User     @relation("TicketAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  fileName           String
  mimeType           String
  size               Int
  cloudinaryPublicId String   @unique
  secureUrl          String
  createdAt          DateTime @default(now())

  @@index([ticketId])
  @@index([uploadedByUserId])
}

model TicketEvent {
  id        Int      @id @default(autoincrement())
  authorId  String
  ticketId  String
  reference String
  reason    String
  createdAt DateTime @default(now())

  @@index([authorId, createdAt])
}
