{
  "name": "engineering-foundation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.0"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:integration": "pnpm --filter @repo/api exec tsx --test ../../infra/test/backend-integration.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @repo/database generate",
    "db:migrate": "pnpm --filter @repo/database migrate",
    "docker:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^6.0.0"
  }
}
