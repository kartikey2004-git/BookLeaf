# Application (apps/api)
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PROXY_URL=http://localhost:4000
LOG_LEVEL=info

# Database (packages/database and local Docker PostgreSQL)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:change-me-for-local-development@localhost:5432/app?schema=public
# Direct (non-pooled) URL for Prisma migrations. For local Postgres it may match DATABASE_URL.
DIRECT_URL=postgresql://app:change-me-for-local-development@localhost:5432/app?schema=public

# Authentication (packages/auth)
BETTER_AUTH_SECRET=replace-with-a-32-byte-local-development-secret
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4000
# Development-only: required by `pnpm --filter @repo/auth provision:demo`.
BOOKLEAF_DEMO_PASSWORD=

# Inngest (optional for local development; the /api/inngest route in apps/web serves the shared functions)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=http://127.0.0.1:8288

# Gemini (server-side only; required only by the AI draft endpoint and the Inngest ticket-AI functions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000

# Cloudinary (server-side only; required for ticket attachment upload presets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Optional OAuth providers (packages/auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
